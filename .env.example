# ---- Database ----
# PostgreSQL connection string (used by api, worker, and db package)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bespoke

# ---- Redis (Upstash) ----
# Use the Upstash TCP endpoint (rediss://...), NOT the REST URL.
# BullMQ requires a persistent TCP connection via ioredis.
REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3001

# ---- Secret encryption (api + worker) ----
# 32-byte key as 64 hex chars, used to encrypt stored secrets at rest (the
# user's own OpenRouter key). MUST be identical for api and worker.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# ---- AI (OpenRouter via Vercel AI SDK) ----
# The Vercel AI SDK needs no key of its own — only OpenRouter. Read by both
# the api (inline explain helpers) and the worker (scrape + generation).
OPENROUTER_API_KEY=sk-or-...
# Fallback model when a user has not chosen one. Used by the worker for
# scrape/vision extraction and by the api/worker as the generation fallback.
# The per-user message-generation model is set in Settings.
OPENROUTER_MODEL=anthropic/claude-sonnet-latest

# ---- Scraping (Firecrawl) ----
FIRECRAWL_API_KEY=fc-...

# Optional: GitHub user/repo URLs are fetched via the GitHub REST API instead
# of Firecrawl. A token raises the rate limit from 60 to 5000 req/hr.
GITHUB_TOKEN=ghp_...

# ---- File Storage (Cloudinary) ----
# API signs uploads; the browser uploads files direct to Cloudinary.
# The API secret stays server-side (api + worker) — never exposed to the web.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# ---- Web (browser-exposed) ----
# Cloudinary cloud name is returned by the sign endpoint, so the web app
# needs no Cloudinary env of its own.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Auth base URL. In local dev = api URL (direct). In prod = web origin so auth
# requests proxy through Next.js (/api/auth/*) and cookies land on the web domain.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
# Server-only. In prod = the actual Fastify API URL (never the web origin).
# Used by the Next.js /api/* proxy to avoid a proxy loop.
API_INTERNAL_URL=http://localhost:3001
